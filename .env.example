# Copy to .env.local for local development. On Vercel, set these in Project Settings → Environment Variables.

# Password for the /admin orders dashboard. Leave unset to turn the dashboard off.
ADMIN_PASSWORD=

# Upstash Redis (added automatically when you connect Upstash from the Vercel Marketplace).
# Without these, `npm run dev` stores orders in .data/store.json instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
